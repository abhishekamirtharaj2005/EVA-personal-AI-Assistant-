# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd

# ─── Virtual Environments ─────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ─── Environment & Secrets ────────────────────────────────
.env
.env.*
*.env
*.secret
credentials.json
token.json
tokens.json

# ─── IDE / Editor ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ─── OS Files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Distribution / Build ────────────────────────────────
dist/
build/
*.egg-info/
*.egg
*.whl

# ─── EVA Runtime Config & Sensitive Data ──────────────────
# Ignore all json files in config except the example template
config/*.json
!config/settings.example.json

# Encrypted credentials/vaults
config/*.enc
*.enc

# Runtime directories
config/certs/
config/logs/
config/reminders/
config/uploads/
config/recordings/
config/generated_images/
config/screenshots/

# ─── SSL Certificates ────────────────────────────────────
*.pem
*.key
*.crt
*.csr

# ─── Generated Media ──────────────────────────────────────
recordings/
*.mp4
*.mkv
*.avi
*.webm

# ─── Compiled Qt Resources ───────────────────────────────
*.qrc
moc_*.cpp
ui_*.h

# ─── Playwright & Browser Automation ──────────────────────
playwright-report/
test-results/
.playwright/

# ─── Testing & Coverage ───────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# ─── Misc ─────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
